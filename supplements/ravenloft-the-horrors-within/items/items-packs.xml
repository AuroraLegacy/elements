			<p class="indent" style="margin-bottom:5px">• 3 Vials</p>
			<p><b>Note:</b> This pack doesn't include 16 GP.</p>
		</description>
		<setters>
			<set name="category">Equipment Packs</set>
			<set name="cost">—</set>
			<set name="weight">—</set>
