	<!-- Background Equipment Packs -->
	<element name="Background Equipment Pack (Haunted One)" type="Item" source="Ravenloft: The Horrors Within" id="ID_WOTC_RHW_ITEM_BACKGROUND_EQUIPMENT_PACK_HAUNTED_ONE">
		<description>
			<p style="margin-bottom:5px">This pack contains items that are given to a character of Haunted One Background, if you chose option A for Equipment.</p>
			<p>You will receive following items by extracting contents of this pack:</p>
			<p class="indent">• Crowbar</p>
			<p class="indent">• Holy Water (1 flask)</p>
			<p class="indent">• Mirror</p>
			<p class="indent">• Oil (2 flasks)</p>
			<p class="indent">• Signal Whistle</p>
			<p class="indent">• Tinderbox</p>
			<p class="indent">• Traveler's Clothes</p>
			<p class="indent">• 5 Torches</p>
			<p class="indent" style="margin-bottom:5px">• Waterskin</p>
			<p><b>Note:</b> This pack doesn't include the Gaming Set of the same kind as Proficiency gained from this Background (can be taken from "Tools" Equipment category) and 14 GP.</p>
		</description>
		<setters>
			<set name="category">Equipment Packs</set>
			<set name="cost">—</set>
			<set name="weight">—</set>
		</setters>
		<extract>
			<item>ID_WOTC_PHB24_ITEM_CROWBAR</item>
			<item>ID_WOTC_PHB24_ITEM_HOLY_WATER</item>
			<item>ID_WOTC_PHB24_ITEM_MIRROR</item>
			<item amount="2">ID_WOTC_PHB24_ITEM_OIL</item>
			<item>ID_WOTC_PHB24_ITEM_SIGNAL_WHISTLE</item>
			<item>ID_WOTC_PHB24_ITEM_TINDERBOX</item>
			<item>ID_WOTC_PHB24_ITEM_CLOTHES_TRAVELERS</item>
			<item amount="5">ID_WOTC_PHB24_ITEM_TORCH</item>
			<item>ID_WOTC_PHB24_ITEM_WATERSKIN</item>
		</extract>
	</element>

	<element name="Background Equipment Pack (Investigator)" type="Item" source="Ravenloft: The Horrors Within" id="ID_WOTC_RHW_ITEM_BACKGROUND_EQUIPMENT_PACK_INVESTIGATOR">
