<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Equipment Packs</name>
		<description>Equipment Packs from Astarion's Book of Hungers.</description>
		<update version="0.0.1">
			<file name="items-packs.xml" url="https://raw.githubusercontent.com/AuroraLegacy/elements/master/supplements/astarions-book-of-hungers/items/items-packs.xml" />
		</update>
	</info>

	<!-- Background Equipment Packs -->
	<element name="Background Equipment Pack (Carouser)" type="Item" source="Astarion’s Book of Hungers" id="ID_WOTC_ABH_ITEM_BACKGROUND_EQUIPMENT_PACK_CAROUSER">
		<description>
			<p style="margin-bottom:5px">This pack contains items that are given to a character of Carouser Background, if you chose option A for Equipment.</p>
			<p>You will receive following items by extracting contents of this pack:</p>
			<p class="indent">• Dagger</p>
			<p class="indent">• Fine Clothes</p>
			<p class="indent">• Glass Bottle</p>
			<p class="indent">• Mirror</p>
			<p class="indent">• Perfume</p>
			<p class="indent">• Pouch</p>
			<p class="indent" style="margin-bottom:5px">• Tinderbox</p>
			<p><b>Note:</b> This pack doesn't include the Gaming Set of the same kind as Proficiency gained from this Background (can be taken from "Tools" Equipment category) and 19 GP.</p>
		</description>
		<setters>
			<set name="category">Equipment Packs</set>
			<set name="cost">—</set>
			<set name="weight">—</set>
		</setters>
		<extract>
			<item>ID_WOTC_PHB24_WEAPON_DAGGER</item>
			<item>ID_WOTC_PHB24_ITEM_CLOTHES_FINE</item>
			<item>ID_WOTC_PHB24_ITEM_BOTTLE_GLASS</item>
			<item>ID_WOTC_PHB24_ITEM_MIRROR</item>
			<item>ID_WOTC_PHB24_ITEM_PERFUME</item>
			<item>ID_WOTC_PHB24_ITEM_POUCH</item>
			<item>ID_WOTC_PHB24_ITEM_TINDERBOX</item>
		</extract>
	</element>

	<element name="Background Equipment Pack (Vampire Devotee)" type="Item" source="Astarion’s Book of Hungers" id="ID_WOTC_ABH_ITEM_BACKGROUND_EQUIPMENT_PACK_VAMPIRE_DEVOTEE">
		<description>
			<p style="margin-bottom:5px">This pack contains items that are given to a character of Vampire Devotee Background, if you chose option A for Equipment.</p>
			<p>You will receive following items by extracting contents of this pack:</p>
			<p class="indent">• Cook's Utensils</p>
			<p class="indent">• Fine Clothes</p>
			<p class="indent">• 2 Glass Bottles</p>
			<p class="indent">• Healer's Kit</p>
			<p class="indent">• Perfume</p>
			<p class="indent">• Lamp</p>
			<p class="indent">• Oil (3 flasks)</p>
			<p class="indent" style="margin-bottom:5px">• Waterskin</p>
			<p><b>Note:</b> This pack doesn't include 19 GP.</p>
		</description>
		<setters>
			<set name="category">Equipment Packs</set>
			<set name="cost">—</set>
			<set name="weight">—</set>
		</setters>
		<extract>
			<item>ID_WOTC_PHB24_ITEM_TOOL_COOKS_UTENSILS</item>
			<item>ID_WOTC_PHB24_ITEM_CLOTHES_FINE</item>
			<item amount="2">ID_WOTC_PHB24_ITEM_BOTTLE_GLASS</item>
			<item>ID_WOTC_PHB24_ITEM_HEALERS_KIT</item>
			<item>ID_WOTC_PHB24_ITEM_PERFUME</item>
			<item>ID_WOTC_PHB24_ITEM_LAMP</item>
			<item amount="3">ID_WOTC_PHB24_ITEM_OIL</item>
			<item>ID_WOTC_PHB24_ITEM_WATERSKIN</item>
		</extract>
	</element>

	<element name="Background Equipment Pack (Vampire Survivor)" type="Item" source="Astarion’s Book of Hungers" id="ID_WOTC_ABH_ITEM_BACKGROUND_EQUIPMENT_PACK_VAMPIRE_SURVIVOR">
		<description>
			<p style="margin-bottom:5px">This pack contains items that are given to a character of Vampire Survivor Background, if you chose option A for Equipment.</p>
			<p>You will receive following items by extracting contents of this pack:</p>
			<p class="indent">• Woodcarver's Tools</p>
			<p class="indent">• Crowbar</p>
			<p class="indent">• Hooded Lantern</p>
			<p class="indent">• Holy Symbol (reliquary)</p>
			<p class="indent">• Holy Water</p>
			<p class="indent">• Mirror</p>
			<p class="indent">• Oil (3 flasks)</p>
			<p class="indent">• Tinderbox</p>
			<p class="indent">• Traveler's Clothes</p>
			<p class="indent" style="margin-bottom:5px">• Waterskin</p>
			<p><b>Note:</b> This pack doesn't include 4 GP.</p>
		</description>
		<setters>
			<set name="category">Equipment Packs</set>
			<set name="cost">—</set>
			<set name="weight">—</set>
		</setters>
		<extract>
			<item>ID_WOTC_PHB24_ITEM_TOOL_WOODCARVERS_TOOLS</item>
			<item>ID_WOTC_PHB24_ITEM_CROWBAR</item>
			<item>ID_WOTC_PHB24_ITEM_LANTERN_HOODED</item>
			<item>ID_WOTC_PHB24_ITEM_HOLY_SYMBOL_RELIQUARY</item>
			<item>ID_WOTC_PHB24_ITEM_HOLY_WATER</item>
			<item>ID_WOTC_PHB24_ITEM_MIRROR</item>
			<item amount="3">ID_WOTC_PHB24_ITEM_OIL</item>
			<item>ID_WOTC_PHB24_ITEM_TINDERBOX</item>
			<item>ID_WOTC_PHB24_ITEM_CLOTHES_TRAVELERS</item>
			<item>ID_WOTC_PHB24_ITEM_WATERSKIN</item>
		</extract>
	</element>

</elements>

