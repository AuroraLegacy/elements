<elements>
	<info>
		<name>Phantasmic Circus Trouper</name>
		<description>The Phantasmic Circus Trouper background from Arcana Unleashed.</description>
		<update version="0.0.1">
			<file name="background-phantasmic-circus-trouper.xml" url="https://raw.githubusercontent.com/AuroraLegacy/elements/master/supplements/arcana-unleashed/backgrounds/background-phantasmic-circus-trouper.xml" />
