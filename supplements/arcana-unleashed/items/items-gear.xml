<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Adventuring Gear</name>
		<description>Adventuring Gear from Arcana Unleashed</description>
		<update version="0.0.1">
			<file name="items-gear.xml" url="https://raw.githubusercontent.com/AuroraLegacy/elements/master/supplements/arcana-unleashed/items/items-gear.xml" />
		</update>
	</info>

	<element name="Bejeweled Conclave Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_BEJEWELED_CONCLAVE_TRINKET">
		<description>
			<h5>Bejeweled Conclave Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>An empty perfume bottle that smells faintly of longing</td></tr>
				<tr><td>2</td><td>Three love letters in the same handwriting, signed with different names</td></tr>
				<tr><td>3</td><td>A silk scarf with several hidden pockets</td></tr>
				<tr><td>4</td><td>The signature page from a contract</td></tr>
				<tr><td>5</td><td>A drinking glass carved with a comet</td></tr>
				<tr><td>6</td><td>A gaudy engagement ring with a fake gem</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

	<element name="Bringers of Cosmic Dawn Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_BRINGERS_OF_COSMIC_DAWN_TRINKET">
		<description>
			<h5>Bringers of Cosmic Dawn Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>A razor-sharp, violet-tinted talon</td></tr>
				<tr><td>2</td><td>An uneven spyglass lens that casts flickering pale-green light</td></tr>
				<tr><td>3</td><td>A stone carved with stars in an unfamiliar constellation</td></tr>
				<tr><td>4</td><td>Fragments of a prophecy about flumphs</td></tr>
				<tr><td>5</td><td>A fern frond that twitches like a tentacle</td></tr>
				<tr><td>6</td><td>A small box containing a worm that won't die</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

	<element name="Covenant of the Grave Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_COVENANT_OF_THE_GRAVE_TRINKET">
		<description>
			<h5>Covenant of the Grave Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>A tin of grave dirt</td></tr>
				<tr><td>2</td><td>A self-sterilizing trephine</td></tr>
				<tr><td>3</td><td>A chapbook with illustrations of graveyards</td></tr>
				<tr><td>4</td><td>A zombie's twitching toe</td></tr>
				<tr><td>5</td><td>A small wreath of dried flowers in an old box</td></tr>
				<tr><td>6</td><td>A mysterious organ in a jar of amber fluid</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

	<element name="Crucible Keepers Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_CRUCIBLE_KEEPERS_TRINKET">
		<description>
			<h5>Crucible Keepers Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>A piece of metal pierced by a tornado-driven twig</td></tr>
				<tr><td>2</td><td>A tattered, salt-stained doll</td></tr>
				<tr><td>3</td><td>A chunk of volcanic glass</td></tr>
				<tr><td>4</td><td>Broken wind chimes</td></tr>
				<tr><td>5</td><td>A seashell blackened by a great fire</td></tr>
				<tr><td>6</td><td>Bark seared with lightning-shaped lines</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

	<element name="Horizon Weavers Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_HORIZON_WEAVERS_TRINKET">
		<description>
			<h5>Horizon Weavers Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>A compass that spins lazily</td></tr>
				<tr><td>2</td><td>A map of a lost valley</td></tr>
				<tr><td>3</td><td>A chip of ice that never melts</td></tr>
				<tr><td>4</td><td>A ring inscribed "bring me home again"</td></tr>
				<tr><td>5</td><td>Wicker from the basket of a hot air balloon</td></tr>
				<tr><td>6</td><td>Four orange leaves with unfamiliar shapes</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

	<element name="Ninth Quill Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_NINTH_QUILL_TRINKET">
		<description>
			<h5>Ninth Quill Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>A long fake beard</td></tr>
				<tr><td>2</td><td>A fancy pen that never runs out of ink</td></tr>
				<tr><td>3</td><td>A bag of broken teeth</td></tr>
				<tr><td>4</td><td>A scrap of paper with several crossed-out passwords and the word "caiman" circled</td></tr>
				<tr><td>5</td><td>Two identical playing cards with unfamiliar suits</td></tr>
				<tr><td>6</td><td>A featureless mask with small eyeholes</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

	<element name="Phantasmic Circus Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_PHANTASMIC_CIRCUS_TRINKET">
		<description>
			<h5>Phantasmic Circus Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>An advertisement for a past circus performance, featuring your likeness</td></tr>
				<tr><td>2</td><td>A small tin of white greasepaint</td></tr>
				<tr><td>3</td><td>A green wire stem that produces an illusory flower for 1 minute when brandished dramatically</td></tr>
				<tr><td>4</td><td>A fine silk ribbon, two inches wide and nine feet long</td></tr>
				<tr><td>5</td><td>Bronze finger cymbals</td></tr>
				<tr><td>6</td><td>A battered top hat</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

	<element name="Seers of Sea and Sky Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_SEERS_OF_SEA_AND_SKY_TRINKET">
		<description>
			<h5>Seers of Sea and Sky Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>A piece of driftwood with natural whorls and gnarls that spell out your name</td></tr>
				<tr><td>2</td><td>A windsock</td></tr>
				<tr><td>3</td><td>A tide chart for an unfamiliar seashore</td></tr>
				<tr><td>4</td><td>A roll of seaweed with cryptic symbols written on it in octopus ink</td></tr>
				<tr><td>5</td><td>A small cog from a lighthouse's turning mechanism</td></tr>
				<tr><td>6</td><td>Four oddly shaped white feathers that fit together to form a perfect triangle</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

	<element name="Sheltering Hands Trinket" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_SHELTERING_HANDS_TRINKET">
		<description>
			<h5>Sheltering Hands Trinkets</h5>
			<table>
				<thead>
					<tr><td class="col-10">1d6</td><td>Trinket</td></tr>
				</thead>
				<tr><td>1</td><td>A tin of lotion to ease rashes</td></tr>
				<tr><td>2</td><td>A religious tract for an unfamiliar deity of healing</td></tr>
				<tr><td>3</td><td>A child's drawing of two parents smiling</td></tr>
				<tr><td>4</td><td>A utensil with a fork on one end and spoon on the other</td></tr>
				<tr><td>5</td><td>A pouch of sweet spices</td></tr>
				<tr><td>6</td><td>A windup toy soldier holding a large shield</td></tr>
			</table>
		</description>
		<setters>
			<set name="category">Adventuring Gear</set>
			<set name="stackable">false</set>
		</setters>
	</element>

</elements>
