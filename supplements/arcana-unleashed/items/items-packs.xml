	<!-- Background Equipment Packs -->
	<element name="Background Equipment Pack (Agent of the Ninth Quill)" type="Item" source="Arcana Unleashed" id="ID_WOTC_AU_ITEM_BACKGROUND_EQUIPMENT_PACK_AGENT_OF_THE_NINTH_QUILL">
		<description>
			<p style="margin-bottom:5px">This pack contains items that are given to a character of Agent of the Ninth Quill Background, if you chose option A for Equipment.</p>
			<p>You will receive following items by extracting contents of this pack:</p>
			<p class="indent">• Dagger</p>
			<p class="indent">• Light Hammer</p>
			<p class="indent">• Thieves' Tools</p>
			<p class="indent">• Iron Spikes</p>
			<p class="indent">• Rope</p>
			<p class="indent" style="margin-bottom:5px">• Traveler's Clothes</p>
			<p><b>Note:</b> This pack doesn't include 17 GP.</p>
		</description>
		<setters>
			<set name="category">Equipment Packs</set>
			<set name="cost">—</set>
			<set name="weight">—</set>
		</setters>
		<extract>
			<item>ID_WOTC_PHB24_WEAPON_DAGGER</item>
			<item>ID_WOTC_PHB24_WEAPON_LIGHT_HAMMER</item>
			<item>ID_WOTC_PHB24_ITEM_TOOL_THIEVES_TOOLS</item>
			<item>ID_WOTC_PHB24_ITEM_IRON_SPIKES</item>
			<item>ID_WOTC_PHB24_ITEM_ROPE</item>
			<item>ID_WOTC_PHB24_ITEM_CLOTHES_TRAVELERS</item>
		</extract>
	</element>

