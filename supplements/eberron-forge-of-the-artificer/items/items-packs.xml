			<p class="indent" style="margin-bottom:5px">• Traveler's Clothes</p>
			<p><b>Note:</b> This pack doesn't include 16 GP.</p>
		</description>
		<setters>
			<set name="category">Equipment Packs</set>
			<set name="cost">—</set>
			<set name="weight">—</set>
		</setters>
		<extract>
			<item>ID_WOTC_PHB24_WEAPON_DAGGER</item>
			<item>ID_WOTC_PHB24_ITEM_TOOL_DISGUISE_KIT</item>
			<item>ID_WOTC_PHB24_ITEM_COSTUME</item>
